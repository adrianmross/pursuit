{
  "git": {
    "deploymentEnabled": { "**": false, "main": true }
  },
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.go" }
  ],
  "crons": [
    { "path": "/v1/cron/links", "schedule": "0 8 * * *" }
  ],
  "functions": {
    "api/index.go": {
      "maxDuration": 60
    }
  }
}
