export DIRENV_WARN_TIMEOUT=20s

# No auto-activation on cd: enter the environment with `devenv shell`. The
# environment still loads for callers that set DIRENV_WARM=1: the worktrunk
# background warm-up (`direnv exec`) and agent session hooks (`direnv export`).
# Set DIRENV_WARM=1 in your shell to get auto-activation back.
if [ -n "${DIRENV_WARM:-}" ]; then
  eval "$(devenv direnvrc)"
  use devenv
fi
