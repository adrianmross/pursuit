{
  "manifest_version": 3,
  "name": "Pursuit",
  "version": "0.6.0",
  "description": "Save the job you are viewing, fill the application form from your Pursuit tracker, and attach your résumé. Never clicks Submit.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Pursuit",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open the Pursuit panel on this page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "panel.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pursuit@localhost",
      "strict_min_version": "128.0"
    }
  }
}
