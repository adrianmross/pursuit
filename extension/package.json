{
  "name": "pursuit-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "e2e": "node build.mjs && playwright test",
    "try": "node build.mjs && node --experimental-strip-types --no-warnings e2e/try.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/chrome": "0.1.24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.10",
    "linkedom": "0.18.12",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.65.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
